# Supabase (almacenamiento de reservas)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notificación por email cuando se agenda una reunión (Gmail SMTP)
# Ver SETUP-RESERVAS.md para generar la contraseña de aplicación.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcional: a quién llega el aviso si es distinto de GMAIL_USER
BOOKING_NOTIFICATION_EMAIL=

# Creación automática del evento en Google Calendar (opcional)
# Ver SETUP-RESERVAS.md para crear la cuenta de servicio.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
